<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:converters="clr-namespace:Listup.Views.Converters"
             x:Class="Listup.Views.CurrencySelectionPage"
             x:Name="RootPage"
             Style="{StaticResource GlobalSecondaryPageBackgroundStyle}">

    <ContentPage.Resources>
        <converters:BooleanNegationConverter x:Key="BooleanNegation" />
    </ContentPage.Resources>

    <ContentPage.Content>
        <StackLayout x:Name="StkPage">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackLayout Grid.Row="0" Style="{StaticResource TitleContainer}">
                        <Label Text="SELECIONE SUA MOEDA" Style="{StaticResource TitleLabel}" />
                        <Label Style="{StaticResource SubtitleLabel}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Isso serve apenas para a formatação dos preços. " />
                                    <Span Text="Os valores não são convertidos." Style="{StaticResource SubtitleSpanBold}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </StackLayout>

                    <CollectionView Grid.Row="1" ItemsSource="{Binding CurrenciesList}" Style="{StaticResource CtvOptionsCurrency}">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="12" HorizontalItemSpacing="1" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <ContentView>
                                    <Frame Style="{StaticResource OptionsContainer}">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding BindingContext.ChangeCurrencyCommand, Source={x:Reference RootPage}}" CommandParameter="{Binding .}" />
                                        </Frame.GestureRecognizers>
                                        <StackLayout Orientation="Vertical">
                                            <Label Text="{Binding Symbol}" Style="{StaticResource LblCurrencySymbol}" />
                                            <Label Text="{Binding Name}" Style="{StaticResource LblCurrencyName}" />
                                        </StackLayout>
                                    </Frame>
                                </ContentView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Text="Voltar" IsVisible="{Binding IsUserOnboarding, Converter={StaticResource BooleanNegation}}" Grid.Row="2" Style="{StaticResource GlobalPrimaryButton}" Command="{Binding NavigateBackCommand}" />

                </Grid>
            </StackLayout>
    </ContentPage.Content>
</ContentPage>