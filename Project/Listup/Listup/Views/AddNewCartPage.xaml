<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pancake="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             xmlns:toolkit="http://xamarin.com/schemas/2020/toolkit"
             xmlns:converters="clr-namespace:Listup.Views.Converters"
             x:Class="Listup.Views.AddNewCartPage"
             Style="{StaticResource GlobalPrimaryOpaqueBackground}" Padding="0">

    <ContentPage.Resources>
        <converters:BooleanNegationConverter x:Key="BooleanNegation" />
    </ContentPage.Resources>

    <Grid>
        <Frame IsVisible="{Binding IsLoading}"
         Style="{StaticResource ActivityIndicatorContainer}">
            <ActivityIndicator IsRunning="True"
                       Style="{StaticResource ActivityIndicator}" />
        </Frame>

        <Grid RowDefinitions="*,Auto" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" IsVisible="{Binding IsLoading, Converter={StaticResource BooleanNegation}}" Style="{StaticResource ContentConteinerGrid}">
            <Frame Grid.Row="0" Style="{StaticResource FrameCloseScreen}" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseScreenCommand}" />
                </Frame.GestureRecognizers>
            </Frame>

            <Frame Grid.Row="1"  Style="{StaticResource ExternalBottomContainer}" >
            <pancake:PancakeView Style="{StaticResource GlobalInternalBottomContainer}">
                    <StackLayout Orientation="Vertical" HorizontalOptions="FillAndExpand">

                        <Label Text="Iniciar em qual modo?" Style="{StaticResource TitleLabel}" />

                        <Frame Style="{StaticResource OptionContainer}">

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AddNewCartCommand}" CommandParameter="cart" />
                            </Frame.GestureRecognizers>

                            <Grid ColumnDefinitions="1*,3*" ColumnSpacing="0" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Padding="0">
                                <Grid Grid.Column="0" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                                    <StackLayout Style="{StaticResource OptionInternalContainersStackLayout}">
                                        <Label Text="&#xf07a;" Style="{StaticResource OptionIcon}" />
                                        <Label Text="Carrinho" Style="{StaticResource OptionTitle}" />
                                    </StackLayout>
                                </Grid>
                                <Grid Grid.Column="1" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">

                                    <StackLayout Style="{StaticResource OptionInternalContainersStackLayout}">
                                        <Label Text="Adicione produtos ao carrinho&#x0a;durante uma compra" Style="{StaticResource OptionLabelDescription}" />
                                    </StackLayout>

                                </Grid>
                            </Grid>
                        </Frame>

                        <Frame Style="{StaticResource OptionContainer}">

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AddNewCartCommand}" CommandParameter="list" />
                            </Frame.GestureRecognizers>

                            <Grid ColumnDefinitions="1*,3*" ColumnSpacing="0" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" Padding="0">
                                <Grid Grid.Column="0" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
                                    <StackLayout Style="{StaticResource OptionInternalContainersStackLayout}">
                                        <Label Text="&#xf303;" Style="{StaticResource OptionIcon}" />
                                        <Label Text="Lista" Style="{StaticResource OptionTitle}" />
                                    </StackLayout>
                                </Grid>
                                <Grid Grid.Column="1" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">

                                    <StackLayout Style="{StaticResource OptionInternalContainersStackLayout}">
                                        <Label Text="Crie uma lista de compras&#x0a;para usar depois" Style="{StaticResource OptionLabelDescription}" />
                                    </StackLayout>

                                </Grid>
                            </Grid>
                        </Frame>

                        <Label Text="*Você pode alterar isso depois" Style="{StaticResource GlobalFootnoteText}"/>

                    </StackLayout>
                </pancake:PancakeView>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>